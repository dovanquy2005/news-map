# ==============================================================================
# Vietnam News Map — Backend API Environment Configuration
# ==============================================================================

# Runtime environment: local | staging | production
APP_ENV=local

# Server Port
PORT=8000

# Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Allowed CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Connection URL (PostgreSQL + PostGIS)
# Default matches infra/docker-compose.yml
DATABASE_URL=postgresql://news_map:NewsMapDev_2026!@localhost:5432/news_map
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_TIMEOUT_MS=5000

# Redis Cache & Queue Connection URL
# Default matches infra/docker-compose.yml
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# Google Maps API Keys
# MAPS_BROWSER_KEY is public (restricted by HTTP referrer in Google Cloud Console)
MAPS_BROWSER_KEY=
# MAPS_SERVER_KEY is private (used by geocoding backend worker, restricted by IP)
MAPS_SERVER_KEY=

# LLM / Extraction Provider Configuration
# Supported providers: gemini-1.5-flash, gemini-1.5-pro, etc.
LLM_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=2048

# Rate Limiting (Requests Per Second)
RATE_LIMIT_ANONYMOUS_RPS=10
RATE_LIMIT_SEARCH_RPS=5
RATE_LIMIT_ADMIN_RPS=20

# Admin Authentication & Session
# In production, must be at least 32 characters and securely generated
ADMIN_JWT_SECRET=dev-insecure-admin-jwt-secret-change-in-production
ADMIN_SESSION_TTL_HOURS=12
