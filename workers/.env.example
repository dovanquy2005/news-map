# ==============================================================================
# Vietnam News Map — Background Workers Configuration
# ==============================================================================

# Runtime environment: local | staging | production
APP_ENV=local

# Logging Level
LOG_LEVEL=INFO

# Database Connection (workers write raw articles, extracted events, locations, clusters)
DATABASE_URL=postgresql://news_map:NewsMapDev_2026!@localhost:5432/news_map
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_TIMEOUT_MS=10000

# Redis Connection (workers consume from queues: ingestion, extraction, geocoding, etc.)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# Geocoding Server API Key (private, IP restricted)
MAPS_SERVER_KEY=

# LLM / AI Model Extraction Key
LLM_API_KEY=
LLM_MODEL_NAME=gemini-1.5-flash
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=2048
