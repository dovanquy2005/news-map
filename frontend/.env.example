# ==============================================================================
# Vietnam News Map — Frontend Responsive Web Configuration
# ==============================================================================
# IMPORTANT SECURITY RULE:
# ONLY browser-safe variables prefixed with VITE_ may be included here.
# NEVER include DATABASE_URL, REDIS_URL, MAPS_SERVER_KEY, or LLM_API_KEY.
# ==============================================================================

# Backend Public API URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Google Maps JavaScript API Key (browser-restricted via HTTP referrer)
VITE_MAPS_BROWSER_KEY=
